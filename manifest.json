{
  "manifest_version": 3,
  "name": "Fucking Blur",
  "version": "1.6.0",
  "description": "移除网页中的 CSS 和 JavaScript 干扰效果、复制限制以及指定的第三方广告元素，同时不触碰 DRM。",
  "browser_specific_settings": {
    "gecko": {
      "id": "fucking-blur@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["override.css"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "permissions": []
}
